<Window x:Class="KHZ.Sheet.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KHZ Sheet"
        Style="{StaticResource {x:Type Window}}"
        Width="1440"
        Height="900"
        MinWidth="1000"
        MinHeight="650"
        Icon="Assets/khz-sheet.ico"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource GridBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Image Source="Assets/khz-sheet.png"
                           Width="42" Height="42"
                           Margin="0,0,12,0"
                           Stretch="Uniform"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="KHZ Sheet"
                                   FontSize="22"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Deterministic local-first workbook"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10,4"
                        VerticalAlignment="Center">
                    <TextBlock Text="PRODUCTIVITY / SPREADSHEET / LOCAL-FIRST"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource GridBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <WrapPanel>
                <Button Content="New Sheet" Click="NewSheet_Click"/>
                <Button Content="Open XLSX" Click="OpenXlsx_Click"/>
                <Button Content="Open CSV" Click="OpenCsv_Click"/>
                <Button Content="Save CSV" Click="SaveCsv_Click"/>
                <Button x:Name="ExportXlsxButton" Content="Export XLSX" Click="ExportXlsx_Click"/>
                <Separator Width="12" Opacity="0"/>
                <Button Content="Undo" Click="Undo_Click" ToolTip="Ctrl+Z"/>
                <Button Content="Redo" Click="Redo_Click" ToolTip="Ctrl+Y"/>
                <Button Content="Freeze A" Click="FreezeFirstColumn_Click"/>
                <Separator Width="12" Opacity="0"/>
                <TextBox x:Name="FindBox" Width="170" Margin="0,0,6,0" ToolTip="Find in cell inputs · Ctrl+F"/>
                <Button Content="Find Next" Click="FindNext_Click"/>
                <Separator Width="12" Opacity="0"/>
                <Button x:Name="RecalculateButton" Content="Recalculate" Click="Recalculate_Click"/>
                <Button x:Name="VerifyButton" Content="Verify Proof" Click="Verify_Click" Style="{StaticResource AccentButton}"/>
                <Button x:Name="CopyProofButton" Content="Copy Proof" Click="CopyProof_Click"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource GridBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,7">
            <WrapPanel>
                <TextBlock Text="Format" Margin="0,0,10,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ComboBox x:Name="FontFamilyBox" Width="170" SelectionChanged="FontFamilyBox_SelectionChanged"/>
                <ComboBox x:Name="FontSizeBox" Width="74" IsEditable="True" SelectionChanged="FontSizeBox_SelectionChanged"/>
                <Button Content="B" Width="34" Padding="0,7" FontWeight="Bold" ToolTip="Bold" Click="Bold_Click"/>
                <Button Content="I" Width="34" Padding="0,7" FontStyle="Italic" ToolTip="Italic" Click="Italic_Click"/>
                <Button Width="34" Padding="0,7" ToolTip="Underline" Click="Underline_Click"><TextBlock Text="U" TextDecorations="Underline"/></Button>
                <Button Content="Wrap" ToolTip="Wrap text" Click="Wrap_Click"/>
                <ComboBox x:Name="NumberFormatBox" Width="112" SelectionChanged="NumberFormatBox_SelectionChanged"/>
                <ComboBox x:Name="TextColorBox" Width="120" SelectionChanged="TextColorBox_SelectionChanged"/>
                <ComboBox x:Name="FillColorBox" Width="120" SelectionChanged="FillColorBox_SelectionChanged"/>
                <Button Content="Left" Click="AlignLeft_Click"/>
                <Button Content="Center" Click="AlignCenter_Click"/>
                <Button Content="Right" Click="AlignRight_Click"/>
                <Button Content="Borders" Click="Borders_Click"/>
                <Button Content="Table Style" Click="TableStyle_Click"/>
                <Button Content="Create Table" Click="CreateTable_Click"/>
                <Button x:Name="TableTotalsButton" Content="Table + Totals" Click="CreateTableTotals_Click" ToolTip="Create a table and add an exact SUM row below the selected data"/>
                <Button Content="Sort ↑" Click="SortAscending_Click" ToolTip="Sort table view; row numbers remain native coordinates"/>
                <Button Content="Sort ↓" Click="SortDescending_Click"/>
                <Button Content="Original Order" Click="ResetSort_Click"/>
                <ComboBox x:Name="ThemeBox" Width="165" SelectionChanged="ThemeBox_SelectionChanged" ToolTip="Worksheet theme"/>
                <ComboBox x:Name="ChartKindBox" Width="85" ToolTip="Chart type"/>
                <Button x:Name="AddChartButton" Content="Add Chart" Click="AddChart_Click"/>
                <Button x:Name="ViewChartsButton" Content="Charts" Click="ViewCharts_Click"/>
                <TextBox x:Name="RowHeightBox" Width="45" Text="24" ToolTip="Row height in points"/>
                <Button Content="Row Height" Click="RowHeight_Click"/>
                <Button Content="Clear Format" Click="ClearFormat_Click"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="3"
                Background="{DynamicResource PanelRaisedBrush}"
                BorderBrush="{DynamicResource GridBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="NameBox"
                         Grid.Column="0"
                         IsReadOnly="True"
                         Text="A1"
                         HorizontalContentAlignment="Center"
                         FontWeight="SemiBold"/>

                <TextBlock Grid.Column="1"
                           Text="fx"
                           FontStyle="Italic"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentHoverBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2">
                    <TextBox x:Name="FormulaBox" KeyDown="FormulaBox_KeyDown" TextChanged="FormulaBox_TextChanged"
                             ToolTip="Enter a value or formula, for example =SUM(A1:A10)"/>
                    <TextBlock x:Name="FormulaSyntax" FontFamily="Consolas" Margin="8,3,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>

                <Button Grid.Column="3"
                        Content="Apply"
                        Click="ApplyFormula_Click"
                        Margin="8,0,0,0"
                        Style="{StaticResource AccentButton}"/>
            </Grid>
        </Border>

        <Border x:Name="ErrorBanner"
                Grid.Row="4"
                Background="#4A1F24"
                BorderBrush="#FF7B72"
                BorderThickness="0,0,0,1"
                Padding="10,6"
                Visibility="Collapsed">
            <TextBlock x:Name="ErrorBannerText" Foreground="White" TextWrapping="Wrap"/>
        </Border>

        <DataGrid x:Name="SheetGrid"
                  Grid.Row="5"
                  ItemsSource="{Binding}"
                  AutoGenerateColumns="True"
                  RowHeaderWidth="52"
                  RowHeight="NaN"
                  MinRowHeight="28"
                  ColumnWidth="110"
                  FrozenColumnCount="0"
                  LoadingRow="SheetGrid_LoadingRow"
                  AutoGeneratingColumn="SheetGrid_AutoGeneratingColumn"
                  SelectedCellsChanged="SheetGrid_SelectedCellsChanged"
                  CellEditEnding="SheetGrid_CellEditEnding"
                  PreviewKeyDown="SheetGrid_PreviewKeyDown"
                  SelectionUnit="Cell"
                  SelectionMode="Extended"
                  ScrollViewer.CanContentScroll="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                    <EventSetter Event="Loaded" Handler="DataGridCell_Loaded"/>
                </Style>
            </DataGrid.CellStyle>
        </DataGrid>

        <Border Grid.Row="6"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource GridBrush}"
                BorderThickness="0,1,0,0"
                Padding="8,6">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Left"
                        Content="+"
                        Width="32"
                        Height="28"
                        Padding="0"
                        Click="NewSheet_Click"
                        ToolTip="Add sheet"/>

                <ListBox x:Name="SheetList"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource TextBrush}"
                         SelectionChanged="SheetList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="16,6"/>
                            <Setter Property="Margin" Value="0,0,4,0"/>
                            <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="TabBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{DynamicResource GridBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Row="7"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource GridBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="Ready"/>

                <TextBlock x:Name="EngineText"
                           Grid.Column="1"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="engine"/>
            </Grid>
        </Border>
    </Grid>
</Window>
